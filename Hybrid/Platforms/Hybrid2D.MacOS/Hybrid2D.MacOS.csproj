<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateProgramFile>false</GenerateProgramFile>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>Hybrid</RootNamespace>
        <OutputType>Library</OutputType>
        <Nullable>disable</Nullable>
        <IsExe>false</IsExe>
    </PropertyGroup>
    
    <PropertyGroup>
        <Authors>Hybrid2D</Authors>
        <Company>Hybrid2D</Company>
        <Product>Hybrid2D.MacOS</Product>
        <PackageId>Hybrid2D.MacOS</PackageId>
        <Description>Hybrid2D MacOS</Description>
        <Copyright>(c) 2025 - 2026 Hybrid2D</Copyright>
        <PackageTags>Hybrid2D;Game;Framework;MacOS</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://hybrid2d.github.io/Hybrid</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Hybrid2D/hybrid</RepositoryUrl>
        <PackageOutputPath>$(SolutionDir)\.nuget</PackageOutputPath>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <NoWarn>$(NoWarn);NU5100;NU5100;CS8766</NoWarn>
        <IsPackable>true</IsPackable>
    </PropertyGroup>
    
    <ItemGroup>
        <None Include="$(SolutionDir)\Hybrid\Natives\MacOS\**\*" Pack="true" PackagePath="Natives" />
        <None Include="Hybrid2D.MacOS.targets" Pack="true" PackagePath="buildTransitive" />
        <None Include="README.md" Pack="true" PackagePath=""/>
    </ItemGroup>
    
    <ItemGroup>
        <ProjectReference Include="$(SolutionDir)\Hybrid\Hybrid\Hybrid2D.csproj" />
    </ItemGroup>

</Project>