<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-android</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>Hybrid</RootNamespace>
        <OutputType>Library</OutputType>
        <Nullable>disable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <Version>0.0.1</Version>
        <Authors>Hybrid2D</Authors>
        <Company>Hybrid2D</Company>
        <Product>Hybrid2D.Framework.Android</Product>
        <PackageId>Hybrid2D.Framework.Android</PackageId>
        <Copyright>(c) 2025 - 2026 Hybrid2D</Copyright>
        <PackageTags>Hybrid2D;Game;Framework;Desktop</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Description>Hybrid2D Framework for Android</Description>
        <PackageProjectUrl>https://hybrid2d.github.io/Hybrid</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <NoWarn>$(NoWarn);NU5100</NoWarn>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <None Include="Resources\Hybrid2D.Framework.Android.targets" Pack="true" PackagePath="buildTransitive" />
        <None Include="Natives\**\*" Pack="true" PackagePath="Natives" />
        <None Include="README.md" Pack="true" PackagePath=""/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="$(SolutionDir)\Hybrid\Hybrid\Hybrid2D.csproj" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedJar Include="Jars\SDLActivity.jar" />
    </ItemGroup>

</Project>
