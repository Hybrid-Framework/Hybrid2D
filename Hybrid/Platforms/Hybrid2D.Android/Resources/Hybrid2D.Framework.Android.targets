<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <PropertyGroup>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    
    <ItemGroup>
        <AndroidNativeLibrary Include="$(MSBuildThisFileDirectory)..\Natives\armeabi-v7a\**\*" Visible="false" Abi="armeabi-v7a"/>
        <AndroidNativeLibrary Include="$(MSBuildThisFileDirectory)..\Natives\arm64-v8a\**\*" Visible="false" Abi="arm64-v8a"/>
        <AndroidNativeLibrary Include="$(MSBuildThisFileDirectory)..\Natives\x86_64\**\*" Visible="false" Abi="x86_64"/>
        <AndroidNativeLibrary Include="$(MSBuildThisFileDirectory)..\Natives\x86\**\*" Visible="false" Abi="x86"/>
    </ItemGroup>

</Project>