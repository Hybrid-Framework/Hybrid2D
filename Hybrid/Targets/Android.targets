<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <ItemGroup Condition="'$(HybridPlatform)' == 'ANDROID'">

        <AndroidNativeLibrary Remove="$(MSBuildThisFileDirectory)..\..\Natives\**\*" />
        
        <AndroidNativeLibrary Include="$(MSBuildThisFileDirectory)..\..\Natives\Mobile\Android\armeabi-v7a\**\*">
            <Visible>false</Visible>
            <Abi>armeabi-v7a</Abi>
        </AndroidNativeLibrary>

        <AndroidNativeLibrary Include="$(MSBuildThisFileDirectory)..\..\Natives\Mobile\Android\arm64-v8a\**\*">
            <Visible>false</Visible>
            <Abi>arm64-v8a</Abi>
        </AndroidNativeLibrary>

        <AndroidNativeLibrary Include="$(MSBuildThisFileDirectory)..\..\Natives\Mobile\Android\x86_64\**\*">
            <Visible>false</Visible>
            <Abi>x86_64</Abi>
        </AndroidNativeLibrary>

        <AndroidNativeLibrary Include="$(MSBuildThisFileDirectory)..\..\\Mobile\Android\x86\**\*">
            <Visible>false</Visible>
            <Abi>x86</Abi>
        </AndroidNativeLibrary>
        
    </ItemGroup>

</Project>