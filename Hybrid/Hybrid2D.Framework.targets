<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <PropertyGroup>
        <HybridPlatform Condition="'$(HybridPlatform)' == '' AND $(TargetFramework.Contains('net10.0-android'))">ANDROID</HybridPlatform>
        <HybridPlatform Condition="'$(HybridPlatform)' == '' AND $(TargetFramework.Contains('net10.0-browser'))">WEB</HybridPlatform>
        <HybridPlatform Condition="'$(HybridPlatform)' == '' AND $(TargetFramework.Contains('net10.0-ios'))">IOS</HybridPlatform>
        <HybridPlatform Condition="'$(HybridPlatform)' == '' AND $(TargetFramework.Contains('net10.0'))">DESKTOP</HybridPlatform>
        <HybridPlatform Condition="'$(HybridPlatform)' == ''">DESKTOP</HybridPlatform>
    </PropertyGroup>

    <Import Project="$(MSBuildThisFileDirectory)\Targets\Desktop.targets" />
    <Import Project="$(MSBuildThisFileDirectory)\Targets\Android.targets" />
    <Import Project="$(MSBuildThisFileDirectory)\Targets\IOS.targets" />
    <Import Project="$(MSBuildThisFileDirectory)\Targets\Web.targets" />

    <Target Name="HybridBuildTarget" BeforeTargets="Build">
        <Message Importance="High" Text="[Hybrid2D] $(HybridPlatform)" />
    </Target>

</Project>
