<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>Hybrid</RootNamespace>
        <OutputType>Library</OutputType>
        <Nullable>disable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <Authors>Hybrid2D</Authors>
        <Company>Hybrid2D</Company>
        <Product>Hybrid2D</Product>
        <PackageId>Hybrid2D</PackageId>
        <Description>Hybrid2D Framework</Description>
        <Copyright>(c) 2025 - 2026 Hybrid2D</Copyright>
        <PackageTags>Hybrid2D;Game;Framework</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://hybrid2d.github.io/Hybrid</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Hybrid2D/hybrid</RepositoryUrl>
        <PackageOutputPath>$(SolutionDir)\.nuget</PackageOutputPath>
        <PackageReadmeFile>NUGET.md</PackageReadmeFile>
        <NoWarn>$(NoWarn);NU5100</NoWarn>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <None Include="NUGET.md" Pack="true" PackagePath=""/>
        <None Include="$(SolutionDir)\Hybrid.png" Pack="true" PackagePath="" Visible="false"/>
    </ItemGroup>

</Project>
