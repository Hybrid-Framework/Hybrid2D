<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0-android</TargetFramework>
        <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
        <AndroidTargetSdkVersion>35</AndroidTargetSdkVersion>
        <TargetFrameworkVersion>35</TargetFrameworkVersion>
        <AndroidMinSdkVersion>26</AndroidMinSdkVersion>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationId>com.companyname.Android</ApplicationId>
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
        <ApplicationVersion>1</ApplicationVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ImplicitUsings>enable</ImplicitUsings>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\App\App.csproj" />
    </ItemGroup>

    <Import Project="..\..\.items\Shared.props" />
    <Import Project="..\..\.items\Android.props" />
    
</Project>