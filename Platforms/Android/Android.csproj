<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <DefineConstants>ANDROID</DefineConstants>
    </PropertyGroup>
    
    <PropertyGroup>
        <TargetFramework>net8.0-android</TargetFramework>
        <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationId>com.companyname.Android</ApplicationId>
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
        <ApplicationVersion>1</ApplicationVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ImplicitUsings>enable</ImplicitUsings>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <Import Project="..\..\Shared.props" />

    <ItemGroup>
        <AndroidAsset Include="..\..\Engine\Assets\**\*">
            <LogicalName>Assets/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
            <Link>.Assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
        </AndroidAsset>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedJar Include="Jars\SDLActivity.jar">
            <Visible>false</Visible>
        </EmbeddedJar>
        
        <AndroidNativeLibrary Include="..\..\Natives\Android\android-armeabi-v7a\*.so">
            <Visible>false</Visible>
            <Abi>armeabi-v7a</Abi>
        </AndroidNativeLibrary>
        
        <AndroidNativeLibrary Include="..\..\Natives\Android\android-arm64-v8a\*.so">
            <Visible>false</Visible>
            <Abi>arm64-v8a</Abi>
        </AndroidNativeLibrary>
        
        <AndroidNativeLibrary Include="..\..\Natives\Android\android-x86_64\*.so">
            <Visible>false</Visible>
            <Abi>x86_64</Abi>
        </AndroidNativeLibrary>
        
        <AndroidNativeLibrary Include="..\..\Natives\Android\android-x86\*.so">
            <Visible>false</Visible>
            <Abi>x86</Abi>
        </AndroidNativeLibrary>
    </ItemGroup>
    
</Project>