<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <DefineConstants>MOBILE;ANDROID</DefineConstants>
    </PropertyGroup>
    
    <PropertyGroup>
        <AndroidSdkDirectory>$(LOCALAPPDATA)\Android\Sdk</AndroidSdkDirectory>
        <JavaSdkDirectory>C:\Program Files\Android\Android Studio\jbr</JavaSdkDirectory>
    </PropertyGroup>
    
    <PropertyGroup>
        <TargetFramework>net8.0-android</TargetFramework>
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
        <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationId>com.companyname.Android</ApplicationId>
        <ApplicationVersion>1</ApplicationVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ImplicitUsings>enable</ImplicitUsings>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\..\Engine\**\*.cs" Exclude="..\**\bin\**;..\**\obj\**">
            <Link>.Engine\%(RecursiveDir)%(Filename)%(Extension)</Link>
        </Compile>

        <Compile Include="..\..\App\**\*.cs" Exclude="..\**\bin\**;..\**\obj\**">
            <Link>.App\%(RecursiveDir)%(Filename)%(Extension)</Link>
        </Compile>
    </ItemGroup>


    <ItemGroup>
        <EmbeddedJar Include="..\..\Natives\Android\SDLActivity.jar"/>
        
        <AndroidNativeLibrary Include="..\..\Natives\Android\android-armeabi-v7a\*.so">
            <Abi>armeabi-v7a</Abi>
        </AndroidNativeLibrary>
        
        <AndroidNativeLibrary Include="..\..\Natives\Android\android-arm64-v8a\*.so">
            <Abi>arm64-v8a</Abi>
        </AndroidNativeLibrary>
        
        <AndroidNativeLibrary Include="..\..\Natives\Android\android-x86\*.so">
            <Abi>x86</Abi>
        </AndroidNativeLibrary>
        
        <AndroidNativeLibrary Include="..\..\Natives\Android\android-x86_64\*.so">
            <Abi>x86_64</Abi>
        </AndroidNativeLibrary>
    </ItemGroup>
    
</Project>