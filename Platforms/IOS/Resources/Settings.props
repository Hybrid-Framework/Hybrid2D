<Project>

<!-- Content -->
    <ItemGroup>
        <BundleResource Include="..\..\Hybrid.png">
            <Link>%(Filename)%(Extension)</Link>
        </BundleResource>
        
        <BundleResource Include="..\..\App\Content\**\*">
            <LogicalName>Content\%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
            <Link>Content\%(RecursiveDir)%(Filename)%(Extension)</Link>
        </BundleResource>
    </ItemGroup>
    
<!-- Natives -->
    <ItemGroup>
        <NativeReference Remove="Natives\**\*"/>
        <NativeReference Include="Natives\SDL3.xcframework"/>
        <NativeReference Include="Natives\SDL3_image.xcframework"/>
        <NativeReference Include="Natives\SDL3_mixer.xcframework"/>
        <NativeReference Include="Natives\SDL3_ttf.xcframework"/>
    </ItemGroup>

</Project>
