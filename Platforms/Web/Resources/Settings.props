<Project>
    
<!-- Settings -->
    <PropertyGroup>
        <EmccExtraLDFlags>--embed-file ../../App/Content@Content</EmccExtraLDFlags>
        <WasmAllowUndefinedSymbols>true</WasmAllowUndefinedSymbols>
        <WasmEmitSymbolMap>true</WasmEmitSymbolMap>
    </PropertyGroup>

<!-- Content -->
    <ItemGroup>
        <Content Update="wwwroot\index.html" CopyToOutputDirectory="PreserveNewest" />
        <Content Update="wwwroot\main.js" CopyToOutputDirectory="PreserveNewest" />
        
        <EmbeddedResource Include="..\..\Hybrid.png">
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <LogicalName>%(Filename)%(Extension)</LogicalName>
            <Link>%(Filename)%(Extension)</Link>
        </EmbeddedResource>
        
        <None Include="..\..\App\Content\**\*">
            <Link>Content\%(RecursiveDir)%(Filename)%(Extension)</Link>
        </None>
    </ItemGroup>

<!-- Natives -->
    <ItemGroup>
        <NativeFileReference Remove="Natives\**\*"/>
        <NativeFileReference Include="Natives\**\*"/>
        <_WasmPInvokeModules Include="__Internal_emscripten" />
        <_WasmPInvokeModules Include="SDL" />
    </ItemGroup>

</Project>
