<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0-browser</TargetFramework>
        <WasmAllowUndefinedSymbols>true</WasmAllowUndefinedSymbols>
        <WasmEmitSymbolMap>true</WasmEmitSymbolMap>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="$(SolutionDir)\App\App.csproj" />
    </ItemGroup>
    
    <ItemGroup>
        <Content Update="wwwroot\index.html" CopyToOutputDirectory="PreserveNewest" />
        <Content Update="wwwroot\main.js" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <NativeFileReference Remove="$(SolutionDir)\Natives\Web\**\*"/>
        
        <NativeFileReference Include="$(SolutionDir)\Natives\Web\**\*">
            <Visible>false</Visible>
        </NativeFileReference>
        
        <_WasmPInvokeModules Include="SDL">
            <Visible>false</Visible>
        </_WasmPInvokeModules>
    </ItemGroup>
    
</Project>
