<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-ios</TargetFramework>
        <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
        <CodesignKey>iPhone Developer</CodesignKey>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ImplicitUsings>true</ImplicitUsings>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\App\App.csproj" />
    </ItemGroup>

    <ItemGroup>
        <NativeReference Remove="Natives\**\*"/>
        <NativeReference Include="Natives\SDL3.xcframework"/>
        <NativeReference Include="Natives\SDL3_image.xcframework"/>
        <NativeReference Include="Natives\SDL3_mixer.xcframework"/>
        <NativeReference Include="Natives\SDL3_ttf.xcframework"/>
    </ItemGroup>

</Project>
