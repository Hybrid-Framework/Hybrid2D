<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-android</TargetFramework>
        <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
        <AndroidTargetSdkVersion>35</AndroidTargetSdkVersion>
        <TargetFrameworkVersion>35</TargetFrameworkVersion>
        <AndroidMinSdkVersion>26</AndroidMinSdkVersion>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationId>com.companyname.Android</ApplicationId>
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
        <ApplicationVersion>1</ApplicationVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ImplicitUsings>enable</ImplicitUsings>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\App\App.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AndroidResource Include="..\..\App\Resources\Icon.png">
            <Link>Resources\drawable-v26\%(Filename)%(Extension)</Link>
        </AndroidResource>
    </ItemGroup>

    <ItemGroup>
        <AndroidNativeLibrary Remove="Natives\**\*" />
        <AndroidNativeLibrary Include="Natives\armeabi-v7a\**\*" Abi="armeabi-v7a"/>
        <AndroidNativeLibrary Include="Natives\arm64-v8a\**\*" Abi="arm64-v8a"/>
        <AndroidNativeLibrary Include="Natives\x86_64\**\*" Abi="x86_64"/>
        <AndroidNativeLibrary Include="Natives\x86\**\*" Abi="x86"/>
        <EmbeddedJar Include="Jars\SDLActivity.jar"/>
    </ItemGroup>
    
</Project>