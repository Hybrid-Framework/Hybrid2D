<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-android</TargetFramework>
        <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
        <AndroidTargetSdkVersion>35</AndroidTargetSdkVersion>
        <TargetFrameworkVersion>35</TargetFrameworkVersion>
        <AndroidMinSdkVersion>26</AndroidMinSdkVersion>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationId>com.companyname.Android</ApplicationId>
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
        <ApplicationVersion>1</ApplicationVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="$(SolutionDir)\App\App.csproj" />
    </ItemGroup>
    
    <ItemGroup>
        <AndroidNativeLibrary Remove="$(SolutionDir)\Natives\Mobile\Android\**\*" />

        <AndroidNativeLibrary Include="$(SolutionDir)\Natives\Mobile\Android\armeabi-v7a\**\*">
            <Visible>false</Visible>
            <Abi>armeabi-v7a</Abi>
        </AndroidNativeLibrary>

        <AndroidNativeLibrary Include="$(SolutionDir)\Natives\Mobile\Android\arm64-v8a\**\*">
            <Visible>false</Visible>
            <Abi>arm64-v8a</Abi>
        </AndroidNativeLibrary>

        <AndroidNativeLibrary Include="$(SolutionDir)\Natives\Mobile\Android\x86_64\**\*">
            <Visible>false</Visible>
            <Abi>x86_64</Abi>
        </AndroidNativeLibrary>

        <AndroidNativeLibrary Include="$(SolutionDir)\Natives\Mobile\Android\x86\**\*">
            <Visible>false</Visible>
            <Abi>x86</Abi>
        </AndroidNativeLibrary>
    </ItemGroup>

</Project>