<Project>
    
<!-- Settings -->
    <PropertyGroup>
        <Scheme>Web</Scheme>
        <DefineConstants>$(Scheme)</DefineConstants>
        <WasmAllowUndefinedSymbols>true</WasmAllowUndefinedSymbols>
        <WasmEmitSymbolMap>true</WasmEmitSymbolMap>
        <EmccExtraLDFlags>
            -sDEFAULT_LIBRARY_FUNCS_TO_INCLUDE=$autoResumeAudioContext,$dynCall
            --embed-file ../../App/Assets@Assets
            -sALLOW_MEMORY_GROWTH=1
        </EmccExtraLDFlags>
    </PropertyGroup>

<!-- Icon -->
    <PropertyGroup>
        <ApplicationIcon>..\..\Hybrid.ico</ApplicationIcon>
    </PropertyGroup>
    
    <ItemGroup>
        <EmbeddedResource Include="..\..\Hybrid.png" Link="Hybrid.png" />
        <EmbeddedResource Include="..\..\Hybrid.ico" Link="Hybrid.ico" />
    </ItemGroup>
    
<!-- Assets -->
    <ItemGroup>
        <None Include="..\..\App\Assets\**\*">
            <Link>.Assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <Visible>false</Visible>
        </None>
    </ItemGroup>

<!-- Natives -->
    <ItemGroup>
        <NativeFileReference Include="..\..\Natives\Web\**\*.a"/>
        <EmccExportedRuntimeMethod Include="setMainLoop"/>
        <EmccExportedRuntimeMethod Include="SDL"/>
    </ItemGroup>

<!-- Web Files -->
    <ItemGroup>
        <Content Update="wwwroot\index.html" CopyToOutputDirectory="PreserveNewest" />
        <Content Update="wwwroot\main.js" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
