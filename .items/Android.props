<Project>
    
<!-- Settings -->
    <PropertyGroup>
        <Scheme>Android</Scheme>
        <DefineConstants>$(Scheme)</DefineConstants>
    </PropertyGroup>
    
<!-- Assets -->
    <ItemGroup>
        <AndroidAsset Include="..\..\Engine\Assets\**\*">
            <LogicalName>Assets/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
            <Link>.Assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
        </AndroidAsset>
    </ItemGroup>
    
<!-- Natives -->
    <ItemGroup>
        <EmbeddedJar Include="Jars\SDLActivity.jar"/>

        <AndroidNativeLibrary Include="..\..\Natives\Android\armeabi-v7a\*.so">
            <Abi>armeabi-v7a</Abi>
        </AndroidNativeLibrary>

        <AndroidNativeLibrary Include="..\..\Natives\Android\arm64-v8a\*.so">
            <Abi>arm64-v8a</Abi>
        </AndroidNativeLibrary>

        <AndroidNativeLibrary Include="..\..\Natives\Android\x86_64\*.so">
            <Abi>x86_64</Abi>
        </AndroidNativeLibrary>

        <AndroidNativeLibrary Include="..\..\Natives\Android\x86\*.so">
            <Abi>x86</Abi>
        </AndroidNativeLibrary>
    </ItemGroup>

</Project>
