<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-android</TargetFramework>
        <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
        <AndroidTargetSdkVersion>35</AndroidTargetSdkVersion>
        <TargetFrameworkVersion>35</TargetFrameworkVersion>
        <AndroidMinSdkVersion>26</AndroidMinSdkVersion>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationId>com.companyname.Android</ApplicationId>
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
        <ApplicationVersion>1</ApplicationVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <NoWarn>$(NoWarn);NU5100;CS8766</NoWarn>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="$(SolutionDir)\App\App\App.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AndroidNativeLibrary Include="$(SolutionDir)\Hybrid\Natives\Android\armeabi-v7a\**\*" Abi="armeabi-v7a" Visible="false" />
        <AndroidNativeLibrary Include="$(SolutionDir)\Hybrid\Natives\Android\arm64-v8a\**\*" Abi="arm64-v8a" Visible="false" />
        <AndroidNativeLibrary Include="$(SolutionDir)\Hybrid\Natives\Android\x86_64\**\*" Abi="x86_64" Visible="false" />
        <AndroidNativeLibrary Include="$(SolutionDir)\Hybrid\Natives\Android\x86\**\*" Abi="x86" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedJar Include="Jars\SDLActivity.jar"/>
    </ItemGroup>

</Project>