<Project>
    <Target Name="HandleSDLJar" BeforeTargets="PrepareForBuild">
        
        <MakeDir Directories="$(ProjectDir)Jars" />
        
        <Copy SourceFiles="$(SolutionDir)\Hybrid\Natives\Android\Jars\SDLActivity.jar"
              DestinationFolder="$(ProjectDir)Jars"
              SkipUnchangedFiles="true" />
        
    </Target>
</Project>
